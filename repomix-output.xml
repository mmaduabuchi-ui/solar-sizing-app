/* ============================================================ */
/* LIGHT THEME — softened, WCAG AA compliant, paper-like        */
/* ============================================================ */
:root {
  /* Surface — warm off-white, not pure #FFF */
  --background: oklch(0.985 0.002 90);
  --foreground: oklch(0.22 0.008 260);

  /* Cards sit slightly ABOVE the background */
  --card: oklch(0.995 0.001 90);
  --card-foreground: oklch(0.22 0.008 260);

  /* Popovers are pure white (highest elevation) */
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.22 0.008 260);

  /* Primary — keep dark for buttons */
  --primary: oklch(0.28 0.01 260);
  --primary-foreground: oklch(0.985 0 0);

  /* Secondary surfaces */
  --secondary: oklch(0.96 0.004 260);
  --secondary-foreground: oklch(0.28 0.01 260);

  /* Muted — now WCAG AA compliant */
  --muted: oklch(0.96 0.004 260);
