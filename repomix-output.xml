  /* Accent */
  --accent: oklch(0.96 0.004 260);
  --accent-foreground: oklch(0.28 0.01 260);

  /* Status colors */
  --destructive: oklch(0.55 0.22 27);

  /* Borders & inputs — visible but soft */
  --border: oklch(0.91 0.005 260);
  --input: oklch(0.93 0.005 260);
  --ring: oklch(0.55 0.02 260);

  /* Charts */
  --chart-1: oklch(0.65 0.18 250);
  --chart-2: oklch(0.60 0.15 160);
  --chart-3: oklch(0.70 0.17 80);
  --chart-4: oklch(0.55 0.20 30);
  --chart-5: oklch(0.50 0.18 320);

  --radius: 0.625rem;

  /* Sidebar */
  --sidebar: oklch(0.975 0.003 260);
  --sidebar-foreground: oklch(0.22 0.008 260);
  --sidebar-primary: oklch(0.28 0.01 260);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.94 0.005 260);
  --sidebar-accent-foreground: oklch(0.28 0.01 260);
  --sidebar-border: oklch(0.91 0.005 260);
  --sidebar-ring: oklch(0.55 0.02 260);
}

/* ============================================================ */
/* DARK THEME — softened, not pure #000, eye-friendly           */
/* ============================================================ */
.dark {
  --background: oklch(0.16 0.008 260);
  --foreground: oklch(0.94 0.005 90);

