import {
  ChevronLeft,
  ChevronRight,
  Search,
  ShoppingCart,
  Zap,
  Battery,
  Sun,
  Shield,
  Cable,
  Star,
  MapPin,
  X,
  Check,
  ExternalLink,
  Truck,
  Clock,
  Info,
  Plug,
  Filter,
  Sparkles,
} from "lucide-react";

import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
