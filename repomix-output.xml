  --secondary: oklch(0.26 0.012 260);
  --secondary-foreground: oklch(0.94 0.005 90);

  --muted: oklch(0.26 0.012 260);
  --muted-foreground: oklch(0.70 0.015 260);

  --accent: oklch(0.26 0.012 260);
  --accent-foreground: oklch(0.94 0.005 90);

  --destructive: oklch(0.68 0.19 22);

  --border: oklch(1 0 0 / 12%);
  --input: oklch(1 0 0 / 16%);
  --ring: oklch(0.60 0.02 260);

  --chart-1: oklch(0.70 0.18 250);
  --chart-2: oklch(0.65 0.15 160);
  --chart-3: oklch(0.75 0.17 80);
  --chart-4: oklch(0.60 0.20 30);
  --chart-5: oklch(0.55 0.18 320);

  --sidebar: oklch(0.19 0.01 260);
  --sidebar-foreground: oklch(0.94 0.005 90);
  --sidebar-primary: oklch(0.92 0.008 90);
  --sidebar-primary-foreground: oklch(0.20 0.01 260);
  --sidebar-accent: oklch(0.26 0.012 260);
  --sidebar-accent-foreground: oklch(0.94 0.005 90);
  --sidebar-border: oklch(1 0 0 / 12%);
  --sidebar-ring: oklch(0.60 0.02 260);
}

/* ============================================================ */
/* BASE LAYER                                                   */
/* ============================================================ */
@layer base {
  * {
    border-color: var(--border);
    outline-color: color-mix(in oklch, var(--ring) 50%, transparent);
  }

  html {
    font-family: var(--font-sans);
    color-scheme: light;
  }

  html.dark {
    color-scheme: dark;
  }

  body {
    background-color: var(--background);
    color: var(--foreground);
    line-height: 1.625;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
