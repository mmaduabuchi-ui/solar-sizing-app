    (panel) => panel.pmaxW >= minW && panel.pmaxW <= maxW,
  );
}

export function getPanelsByEfficiency(minEfficiency: number): PanelProduct[] {
  return PANEL_DATABASE.filter(
    (panel) => (panel.efficiency || 0) >= minEfficiency,
  );
}
